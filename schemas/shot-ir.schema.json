{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ed3c/higgsfield-studio/schemas/shot-ir.schema.json",
  "title": "Shot IR",
  "description": "One shot of a film, written before any paid generation. shots.json is an array of these.",
  "type": "object",
  "required": ["shot_id", "act", "start_s", "duration_s", "purpose", "framing", "tool", "estimate"],
  "additionalProperties": true,
  "properties": {
    "shot_id": {"type": "string", "pattern": "^S[0-9]{2,3}$"},
    "act": {"type": "integer", "minimum": 1, "maximum": 5},
    "start_s": {"type": "number", "minimum": 0},
    "duration_s": {"type": "number", "exclusiveMinimum": 0, "maximum": 30},
    "purpose": {"type": "string", "description": "What this shot does for the story."},
    "action": {"type": "string"},
    "framing": {"type": "string", "description": "Shot size, angle, lens, composition."},
    "camera_move": {"type": "string"},
    "lighting": {"type": "string"},
    "characters": {"type": "array", "items": {"type": "string"}},
    "location": {"type": "string"},
    "props": {"type": "array", "items": {"type": "string"}},
    "style_refs": {"type": "array", "items": {"type": "string"}, "description": "Test ids or style-bible entries, e.g. S13v2."},
    "audio": {"type": "string"},
    "tool": {"enum": ["cinema-studio-4.0", "soul", "elements", "canvas", "genjutsu", "genjutsu-lite", "kling-4.0", "editor-only"]},
    "keyframe": {"type": "string", "description": "Path or generation id of the locked still. Required before the Animatic gate."},
    "free_stage": {"type": "string", "description": "What can be done on web Unlimited at 0 credits."},
    "estimate": {
      "type": "object",
      "required": ["model", "settings", "units", "takes"],
      "properties": {
        "model": {"type": "string", "description": "Must match budget/cost-table.csv model, or 'free'."},
        "settings": {"type": "string", "description": "Must match budget/cost-table.csv settings."},
        "units": {"type": "number", "minimum": 0},
        "takes": {"type": "number", "minimum": 0}
      }
    },
    "notes": {"type": "string"}
  }
}
