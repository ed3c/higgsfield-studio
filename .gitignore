# Secrets. Never commit Higgsfield credentials, tokens, or API keys.
.env
.env.*
credentials.json
**/*credentials*
**/*secret*
*.pem

# Renders and audio stay out of git. Shot logs stay in CSV and Markdown.
*.mp4
*.mov
*.m4v
*.webm
*.mkv
*.avi
*.wav
*.aif
*.aiff
*.flac
*.mp3
*.aac
*.m4a

# Reference stills and exports for a production. Keep the placeholder.
projects/*/renders/
projects/*/exports/
projects/*/refs/*
!projects/*/refs/.gitkeep

.DS_Store
__pycache__/
*.pyc

# Image-prompt test renders. Score in results.csv; do not commit stills.
tests/**/outputs/

# Free stills for animatics. Picks live in selects.csv; images stay out of git.
projects/*/stills/*
!projects/*/stills/.gitkeep

# Base footage from Neon (IMG_7835). Raw camera files and plates stay out of the public repo.
*.MOV
*.MP4
*.HEIC
projects/2026-11-base-IMG7835/plates/
projects/2026-11-base-IMG7835/plates_sheet.jpg
